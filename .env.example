# ---------------------------------------------------------------------------
# Client / homelab side (client/runpod_client.py and homelab/runpod-proxy).
# Copy to .env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------
# runpod.io -> Settings -> API Keys (a restricted key scoped to this endpoint is best)
RUNPOD_API_KEY=
# From the endpoint page, e.g. abc123xyz
RUNPOD_ENDPOINT_ID=

# ---------------------------------------------------------------------------
# Worker side: set these on the RunPod endpoint (Edit Endpoint -> Environment
# Variables), not here. Listed for reference with their defaults.
# ---------------------------------------------------------------------------
# MODEL_NAME=Qwen/Qwen3-14B-AWQ
# SERVED_MODEL_NAME=runpod-qwen3-14b
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.92
# VLLM_EXTRA_ARGS=--reasoning-parser qwen3
# MAX_CONCURRENCY=16
# Only for gated models; reference a RunPod secret: {{ RUNPOD_SECRET_hf_token }}
# HF_TOKEN=
