# Copy to runpod-proxy.env, chmod 600. Never commit the real file.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Bearer token clients (Open WebUI, bots) must send. Generate: openssl rand -hex 24
PROXY_API_KEY=
# Comma-separated; must match the worker's SERVED_MODEL_NAME
MODELS=runpod-qwen3-14b
UPSTREAM_TIMEOUT=600
